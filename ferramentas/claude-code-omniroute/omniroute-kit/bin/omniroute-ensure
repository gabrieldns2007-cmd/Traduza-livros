#!/usr/bin/env bash
# Garante que o OmniRoute local está no ar. Não reinicia um servidor que já responde.
# Uso: omniroute-ensure [--quiet] [--wait]
set -u
KIT="${OMNIROUTE_KIT:-$HOME/.omniroute-kit}"
. "$KIT/config.sh"
quiet=0; wait=0
for a in "$@"; do case "$a" in --quiet) quiet=1 ;; --wait) wait=1 ;; esac; done
say() { [ "$quiet" = 1 ] || echo "$@"; }

healthy() { curl -fsS -m 3 "$OMNI_URL/api/monitoring/health" >/dev/null 2>&1; }

if healthy; then say "OmniRoute já está no ar em $OMNI_URL"; exit 0; fi
if ! command -v omniroute >/dev/null 2>&1; then say "OmniRoute não está instalado (rode o install.sh do kit)"; exit 1; fi

mkdir -p "$HOME/.omniroute"
# Só aceita conexões de dentro desta máquina e exige chave em toda chamada de modelo.
OMNIROUTE_SERVER_HOST=127.0.0.1 REQUIRE_API_KEY=true \
  nohup omniroute serve --port "$OMNI_PORT" --no-open >"$HOME/.omniroute/kit-server.log" 2>&1 &
say "Iniciando o OmniRoute em segundo plano (log: ~/.omniroute/kit-server.log)"

if [ "$wait" = 1 ]; then
  for _ in $(seq 1 60); do healthy && { say "OmniRoute no ar."; exit 0; }; sleep 2; done
  say "O OmniRoute não respondeu em 2 minutos. Veja ~/.omniroute/kit-server.log"; exit 1
fi
exit 0
