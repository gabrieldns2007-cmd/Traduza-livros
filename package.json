{
  "name": "verso",
  "version": "0.1.0",
  "private": true,
  "description": "Verso — tradução de livros inteiros, capítulo por capítulo, preservando a estrutura.",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "start": "next start -H 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "status": "node scripts/book-status.mjs",
    "app": "next build && next start -H 0.0.0.0",
    "custos": "node scripts/costs.mjs",
    "creditos": "node scripts/credits.mjs"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.0",
    "cheerio": "^1.2.0",
    "dom-serializer": "^2.0.0",
    "domhandler": "^5.0.3",
    "domutils": "^3.2.2",
    "entities": "^8.1.0",
    "fontkit": "^2.0.4",
    "franc-min": "^6.2.0",
    "hyphen": "^1.14.1",
    "jszip": "^3.10.2",
    "next": "^16.4.0",
    "path-browserify": "^1.0.1",
    "pdfkit": "^0.20.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "unpdf": "^1.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/fontkit": "^2.0.9",
    "@types/node": "^22.20.5",
    "@types/path-browserify": "^1.0.3",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.29",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
